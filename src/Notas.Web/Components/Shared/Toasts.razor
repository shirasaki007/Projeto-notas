@implements IDisposable
@inject ToastService Service

<div class="toasts" role="region" aria-label="Notificações" aria-live="polite">
    @foreach (var t in Service.Items)
    {
        <div class="toast toast-@t.Kind.ToString().ToLowerInvariant()" @key="t.Id">
            <Icon Name="@(t.Kind == ToastKind.Error ? "alert" : "check")" Size="16" />
            <span class="toast-msg">@t.Message</span>
            @if (t.Action is not null)
            {
                <button class="toast-action" @onclick="() => RunAsync(t)">@t.ActionLabel</button>
            }
            <button class="icon-btn icon-btn-sm" @onclick="() => Service.Dismiss(t.Id)" aria-label="Fechar notificação"><Icon Name="x" Size="14" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Service.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Service.Changed -= OnChanged;

    private async Task RunAsync(Toast t)
    {
        Service.Dismiss(t.Id);
        if (t.Action is not null) await t.Action();
    }
}
