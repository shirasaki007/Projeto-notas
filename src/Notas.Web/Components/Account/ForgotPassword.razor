@page "/account/forgot-password"
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<AppUser> UserManager
@inject IEmailSender<AppUser> EmailSender
@inject NavigationManager Nav

<PageTitle>Recuperar senha · Notas</PageTitle>

<h1>Recuperar senha</h1>

@if (_sent)
{
    <div class="alert alert-success" role="status">
        Se esse e-mail estiver cadastrado, enviaremos um link para redefinir a senha. Verifique sua caixa de entrada.
    </div>
    <a href="account/login" class="btn btn-secondary btn-block">Voltar ao login</a>
}
else
{
    <p class="lead">Informe seu e-mail e enviaremos um link de redefinição.</p>
    <EditForm Model="Input" FormName="forgot-password" method="post" OnValidSubmit="SendAsync" class="form" novalidate>
        <DataAnnotationsValidator />
        <div class="field">
            <label for="email">E-mail</label>
            <InputText id="email" @bind-Value="Input.Email" type="email" autocomplete="username" inputmode="email" />
            <ValidationMessage For="() => Input.Email" class="field-error" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Enviar link</button>
    </EditForm>
    <p class="auth-links"><a href="account/login">Voltar ao login</a></p>
}

@code {
    private bool _sent;

    [SupplyParameterFromForm] private EmailInput Input { get; set; } = new();

    private async Task SendAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
        if (user is not null)
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var link = Nav.GetUriWithQueryParameters(
                Nav.ToAbsoluteUri("account/reset-password").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code, ["email"] = user.Email });
            await EmailSender.SendPasswordResetLinkAsync(user, user.Email!, link);
        }
        _sent = true; // resposta idêntica exista ou não a conta (anti-enumeração)
    }

    private sealed class EmailInput
    {
        [Required(ErrorMessage = "Informe seu e-mail."), EmailAddress(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = "";
    }
}
