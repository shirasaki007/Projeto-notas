@page "/account/reset-password"
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav

<PageTitle>Nova senha · Notas</PageTitle>

<h1>Definir nova senha</h1>

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert"><ul>@foreach (var e in _errors) { <li>@e</li> }</ul></div>
}

<EditForm Model="Input" FormName="reset-password" method="post" OnValidSubmit="ResetAsync" class="form" novalidate>
    <DataAnnotationsValidator />
    <input type="hidden" name="Input.Code" value="@Input.Code" />
    <input type="hidden" name="Input.Email" value="@Input.Email" />
    <div class="field">
        <label for="password">Nova senha</label>
        <InputText id="password" @bind-Value="Input.Password" type="password" autocomplete="new-password" />
        <ValidationMessage For="() => Input.Password" class="field-error" />
    </div>
    <div class="field">
        <label for="confirm">Confirmar nova senha</label>
        <InputText id="confirm" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="field-error" />
    </div>
    <button type="submit" class="btn btn-primary btn-block">Redefinir senha</button>
</EditForm>

@code {
    private List<string> _errors = [];

    [SupplyParameterFromForm] private ResetInput Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromQuery] private string? Email { get; set; }

    protected override void OnInitialized()
    {
        Input.Code ??= Code;
        Input.Email ??= Email;
    }

    private async Task ResetAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email ?? "");
        if (user is null) { Nav.NavigateTo("account/login?msg=reset"); return; } // não revela se a conta existe

        string token;
        try { token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Code ?? "")); }
        catch (FormatException) { _errors = ["Link inválido ou expirado. Solicite um novo."]; return; }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded) { Nav.NavigateTo("account/login?msg=reset"); return; }
        _errors = result.Errors.Select(e => e.Description).ToList();
    }

    private sealed class ResetInput
    {
        public string? Code { get; set; }
        public string? Email { get; set; }
        [Required(ErrorMessage = "Crie uma senha."), StringLength(100, MinimumLength = 10, ErrorMessage = "A senha deve ter de 10 a 100 caracteres.")]
        public string Password { get; set; } = "";
        [Required(ErrorMessage = "Confirme a senha."), Compare(nameof(Password), ErrorMessage = "As senhas não conferem.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
